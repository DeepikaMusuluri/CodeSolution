/*
You are given an array of integers nums, there is a sliding window of size k which is moving from the very left of the array to the very right. You can only see the k numbers in the window. Each time the sliding window moves right by one position.

Return the max sliding window.

 

Example 1:

Input: nums = [1,3,-1,-3,5,3,6,7], k = 3
Output: [3,3,5,5,6,7]
Explanation: 
Window position                Max
---------------               -----
[1  3  -1] -3  5  3  6  7       3
 1 [3  -1  -3] 5  3  6  7       3
 1  3 [-1  -3  5] 3  6  7       5
 1  3  -1 [-3  5  3] 6  7       5
 1  3  -1  -3 [5  3  6] 7       6
 1  3  -1  -3  5 [3  6  7]      7
Example 2:

Input: nums = [1], k = 1
Output: [1]
 

Constraints:

1 <= nums.length <= 105
-104 <= nums[i] <= 104
1 <= k <= nums.length
*/

import java.util.*;

class Solution {

    public int[] maxSlidingWindow(int[] nums, int k) {

        int n = nums.length;
        int[] result = new int[n - k + 1];

        // Stores array indices
        Deque<Integer> queue = new ArrayDeque<>();

        for (int i = 0; i < n; i++) {

            // Step 1: Remove indices outside the window
            while (!queue.isEmpty() &&
                    queue.peekFirst() <= i - k) {

                queue.pollFirst();
            }

            // Step 2: Remove smaller values from the back
            while (!queue.isEmpty() &&
                    nums[queue.peekLast()] <= nums[i]) {

                queue.pollLast();
            }

            // Step 3: Add the current index
            queue.offerLast(i);

            // Step 4: Store the maximum
            if (i >= k - 1) {

                int index = i - k + 1;

                result[index] = nums[queue.peekFirst()];
            }
        }

        return result;
    }
}

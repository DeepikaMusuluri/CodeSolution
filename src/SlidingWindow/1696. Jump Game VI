/*


Hint
You are given a 0-indexed integer array nums and an integer k.

You are initially standing at index 0. In one move, you can jump at most k steps forward without going outside the boundaries of the array. That is, you can jump from index i to any index in the range [i + 1, min(n - 1, i + k)] inclusive.

You want to reach the last index of the array (index n - 1). Your score is the sum of all nums[j] for each index j you visited in the array.

Return the maximum score you can get.

 

Example 1:

Input: nums = [1,-1,-2,4,-7,3], k = 2
Output: 7
Explanation: You can choose your jumps forming the subsequence [1,-1,4,3] (underlined above). The sum is 7.
Example 2:

Input: nums = [10,-5,-2,4,0,3], k = 3
Output: 17
Explanation: You can choose your jumps forming the subsequence [10,4,3] (underlined above). The sum is 17.
Example 3:

Input: nums = [1,-5,-20,4,-1,3,-6,-3], k = 2
Output: 0
 

Constraints:

1 <= nums.length, k <= 105
-104 <= nums[i] <= 104
*/
import java.util.*;

class Solution {

    public int maxResult(int[] nums, int k) {

        int n = nums.length;

        // score[i] stores the maximum score
        // possible when reaching index i
        int[] score = new int[n];

        // Stores indices in decreasing order
        // of their score values
        Deque<Integer> queue = new ArrayDeque<>();

        // Start at index 0
        score[0] = nums[0];
        queue.offerLast(0);

        for (int i = 1; i < n; i++) {

            // Remove indices that are more than k steps away
            while (!queue.isEmpty() &&
                   queue.peekFirst() < i - k) {

                queue.pollFirst();
            }

            // Calculate the best score for the current index
            score[i] =
                    nums[i] + score[queue.peekFirst()];

            // Remove indices having smaller scores
            while (!queue.isEmpty() &&
                   score[queue.peekLast()] <= score[i]) {

                queue.pollLast();
            }

            // Add the current index
            queue.offerLast(i);
        }

        // Maximum score for reaching the last index
        return score[n - 1];
    }
}


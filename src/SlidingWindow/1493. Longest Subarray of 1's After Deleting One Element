class Solution {
    public int longestSubarray(int[] nums) {
        int left = 0;
        int zeroCount = 0;
        int n = nums.length;
        int result = 0;
        for(int right =0 ; right < n; right++)
        {
            if(nums[right] == 0)
            zeroCount ++;

            //Shrink the window
            if(zeroCount > 1)
            {
                if(nums[left] == 0)
                zeroCount --;

                left++;
            }

            //Caluculate the length of the window 
            int maxLength = right - left;
            result = Math.max(result , maxLength);
        }

        return result;   
    }
}

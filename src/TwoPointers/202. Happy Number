class Solution {
    public boolean isHappy(int n) {

        int slow = n;
        int fast = n;
        do
        {
             slow = sum(slow);
             fast = sum(sum(fast));
        }while( slow != fast);

        return slow == 1;
        
    }

    private int sum (int n)
    {
        int sum =0;
        while(n > 0)
        {
            int n2 = n % 10;
            sum += n2 * n2;
            n = n/10;
        }

        return sum;
    }
}

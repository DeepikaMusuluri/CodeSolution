class Solution {
    public boolean backspaceCompare(String s, String t) {
        int i = s.length() - 1;
        int j = t.length() - 1;

        while (i >= 0 || j >= 0) {
            i = findValidCharacter(s, i);
            j = findValidCharacter(t, j);

            // Only one string has a valid character remaining
            if ((i >= 0) != (j >= 0)) {
                return false;
            }

            // Both have valid characters, but they differ
            if (i >= 0 && j >= 0 &&
                s.charAt(i) != t.charAt(j)) {
                return false;
            }

            i--;
            j--;
        }

        return true;
    }

    private int findValidCharacter(String s, int index) {
        int skip = 0;

        while (index >= 0) {
            if (s.charAt(index) == '#') {
                skip++;
                index--;
            } else if (skip > 0) {
                skip--;
                index--;
            } else {
                break;
            }
        }

        return index;
    }
}

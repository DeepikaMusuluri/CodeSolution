class Solution {
    public String reverseWords(String s) {
        s = s.trim();
        String[] stringWords = s.split("\\s+");
        int left =0;
        int right = stringWords.length - 1;
        while(left < right)
        {
            String temp = stringWords[left];
            stringWords[left] = stringWords[right];
            stringWords[right] = temp;

            left++;
            right--;
        }

        return String.join(" ", stringWords);
    }
}

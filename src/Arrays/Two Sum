import java.util.Arrays;
import java.util.HashMap;
/*
Two Sum
Easy
Topics
Company Tags

Hints
Given an array of integers nums and an integer target, return the indices i and j such that nums[i] + nums[j] == target and i != j.

You may assume that every input has exactly one pair of indices i and j that satisfy the condition.

Return the answer with the smaller index first.

Example 1:

Input:
nums = [3,4,5,6], target = 7

Output: [0,1]
Explanation: nums[0] + nums[1] == 7, so we return [0, 1].

Example 2:

Input: nums = [4,5,6], target = 10

Output: [0,2]
Example 3:

Input: nums = [5,5], target = 10

Output: [0,1]
Constraints:

2 <= nums.length <= 1000
-10,000,000 <= nums[i] <= 10,000,000
-10,000,000 <= target <= 10,000,000
Only one valid answer exists.

 */
public class TwoSum {

    public static void main(String[] args) {

        Solution solution = new Solution();

        // Example 1
        int[] nums1 = {3, 4, 5, 6};
        int target1 = 7;
        System.out.println(Arrays.toString(solution.twoSum(nums1, target1)));
        // Expected Output: [0, 1]

        // Example 2
        int[] nums2 = {4, 5, 6};
        int target2 = 10;
        System.out.println(Arrays.toString(solution.twoSum(nums2, target2)));
        // Expected Output: [0, 2]

        // Example 3
        int[] nums3 = {5, 5};
        int target3 = 10;
        System.out.println(Arrays.toString(solution.twoSum(nums3, target3)));
        // Expected Output: [0, 1]
    }
}

class Solution {
    public int[] twoSum(int[] nums, int target) {
        HashMap<Integer,Integer> map = new HashMap<>();
        for(int i=0;i< nums.length;i++)
        {
            int compliment = target-nums[i];
            // remember the function it is containsKey not contains
            if(map.containsKey(compliment))
            {
                return new int[]{map.get(compliment),i};
            }
            else
                // To add elements in map, the function name is put, not add.
                map.put(nums[i],i);
        }
        return new int[]{-1,-1};
    }
}

//Time complexity - nO(log n) for hash Map it is O(log n)
//Space Complexity - n

import java.util.HashSet;

/*
Given an integer array nums, return true if any value appears more than once in the array; otherwise return false.

Example 1:

Input: nums = [1, 2, 3, 3]

Output: true

Example 2:

Input: nums = [1, 2, 3, 4]

Output: false
Constraints:

0 <= nums.length <= 10^5
-10^9 <= nums[i] <= 10^9

 */
public class ContainsDuplicates {

    public static void main(String[] args) {

        ContainsDuplicatesSolution ContainsDuplicatesSolution = new ContainsDuplicatesSolution();

        // Example 1
        int[] nums1 = {1, 2, 3, 3};
        System.out.println(ContainsDuplicatesSolution.hasDuplicate(nums1)); // true

        // Example 2
        int[] nums2 = {1, 2, 3, 4};
        System.out.println(ContainsDuplicatesSolution.hasDuplicate(nums2)); // false
    }
}

 class ContainsDuplicatesSolution {

     public boolean hasDuplicate(int[] nums) {
         //Here we are using a HashSet for storing unique Values
         HashSet<Integer> set = new HashSet<>();
         for (int num : nums) {
             set.add(num);
         }
         // size() function is used to find the size of the set.
         // Where as length function is used to find the length of the array.
         return set.size() < nums.length;
     }
}
